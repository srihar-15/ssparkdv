# Public Firebase web app settings (safe to include in a browser bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local Auth emulator only; omit in production.
VITE_FIREBASE_AUTH_EMULATOR_URL=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Server identity and access. COMMERCE_OWNER_UID is the Firebase Auth UID of the first owner.
COMMERCE_FIREBASE_PROJECT_ID=
COMMERCE_FIRESTORE_DATABASE=commerce
COMMERCE_OWNER_UID=
COMMERCE_MEDIA_BUCKET=
GOOGLE_CLOUD_PROJECT=

# Cloud Tasks and a private Cloud Run worker.
COMMERCE_TASKS_QUEUE=sparkdv-fulfillment
COMMERCE_TASKS_REGION=asia-south1
COMMERCE_TASKS_SERVICE_ACCOUNT=
COMMERCE_WORKER_URL=

# Razorpay payments and Shiprocket delivery. Never prefix these with VITE_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# Optional order emails.
ORDER_EMAIL_FROM=
RESEND_API_KEY=

# Legacy SQL auth/order API is migration only; leave disabled for production.
COMMERCE_ALLOW_LEGACY_SESSION=0
